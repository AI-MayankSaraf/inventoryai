# Settings for `docker compose`. Copy to .env (next to docker-compose.yml)
# and fill in. Never commit the filled-in copy.
#
# Generate every secret and password below with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# (URL-safe values matter: the database passwords go inside connection URLs.)

# ------------------------------------------------------------ required
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
PLATFORM_DB_PASSWORD=
JWT_SECRET=
SECRETS_KEY=

# The addresses people use. PUBLIC_API_URL is compiled into the web app:
# rebuild the frontend image (`docker compose build frontend`) after changing it.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000
API_PORT=8000

# production refuses to start with weak secrets or DEBUG on.
ENVIRONMENT=production
DEBUG=false

# Address of the reverse proxy in front of the API, so sign-in rate limits
# see each user's own address. Leave as is if nothing proxies the API.
FORWARDED_ALLOW_IPS=127.0.0.1

# ------------------------------------------------------------ S3 (required)
# On AWS leave the two keys blank and give the server an IAM role instead.
# docker-compose.local.yml overrides all of this with a local stand-in.
S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_SSE=AES256
S3_KMS_KEY_ID=

# ------------------------------------------------------------ email
# docker-compose.local.yml sends everything to Mailpit instead.
EMAIL_FROM=no-reply@yourcompany.com
EMAIL_FROM_NAME=InventoryAI
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ------------------------------------------------------------ AI (optional)
# none | ollama | openai (any OpenAI-compatible API). Ollama on the Docker
# host: AI_BASE_URL=http://host.docker.internal:11434
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_SMALL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=0

# Tesseract is built into the API image.
OCR_PROVIDER=tesseract
OCR_LANGUAGES=eng+hin

# Used once, to create the first platform admin without a prompt:
#   docker compose run --rm migrate python -m app.db.seed --admin-email you@yourcompany.com
# Clear it again afterwards.
PLATFORM_ADMIN_PASSWORD=
