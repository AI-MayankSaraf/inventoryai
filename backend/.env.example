# Copy to backend/.env and fill in. Real values never go in git.

DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/inventoryai
APP_DATABASE_URL=postgresql+asyncpg://inventoryai_app:<password>@localhost:5432/inventoryai
PLATFORM_DATABASE_URL=postgresql+asyncpg://inventoryai_platform:<password>@localhost:5432/inventoryai

# ---------------------------------------------------------------- S3 storage
# Every uploaded document lives here and nowhere else (BR-DOC-03). The app
# refuses to start if the bucket is unreachable — there is no local-disk
# fallback by design.
#
# Local development points at the Floci/LocalStack S3 endpoint. On real AWS,
# leave AWS_ENDPOINT_URL blank and leave the two key variables blank as well
# so the instance/task IAM role is used instead of a long-lived key on disk.
S3_BUCKET=inventoryai-documents
AWS_REGION=us-east-1
#AWS_ENDPOINT_URL=http://localhost.floci.io:4500  # wrong: 4500 is the Floci UI
AWS_ENDPOINT_URL=http://localhost:4566
#AWS_ENDPOINT_URL=http://127.0.0.1:5555
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Server-side encryption: AES256 (SSE-S3) or aws:kms with S3_KMS_KEY_ID.
S3_SSE=AES256
# S3_KMS_KEY_ID=

# "downloads are pre-signed and expire in 5 minutes" — BR-DOC-03.
S3_PRESIGN_TTL_SECONDS=300

# ---------------------------------------------------------------- AI models
# Used for spreadsheet column mapping (RFQ import, AI Documents). Every model
# answer is a suggestion a person confirms; if the provider is down, mapping
# falls back to heading rules + your manual choice.
# AI_PROVIDER: none | ollama (local, no key) | openai (any OpenAI-compatible API)
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_API_KEY=
AI_MODEL_SMALL=llama3.2:latest
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_DIMENSIONS=768
AI_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------- Email
# Development: Mailpit (docker container "mailpit") catches every email.
# Read them at http://localhost:8025 - nothing leaves this machine.
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@inventoryai.local
EMAIL_FROM_NAME=InventoryAI
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
# Real delivery: replace the block above with your provider, e.g.
#   Gmail/Google Workspace: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USE_TLS=true
#     SMTP_USERNAME=you@yourdomain.com SMTP_PASSWORD=<16-char app password>
#   Zoho: smtp.zoho.in 587 · Brevo: smtp-relay.brevo.com 587 · AWS SES: email-smtp.ap-south-1.amazonaws.com 587
# A company can also set its own SMTP server in Settings > Email; that wins over this.

# ---------------------------------------------------------------- Worker
# Uploaded documents are read by a background worker, not in the upload
# request. embedded = a worker loop inside the API process (nothing else to
# run); external = run `python -m app.worker` separately (Docker does).
EXTRACTION_WORKER=embedded
WORKER_POLL_SECONDS=2
WORKER_STALE_AFTER_MINUTES=15
WORKER_MAX_RETRIES=3

# ---------------------------------------------------------------- OCR
# Scanned images and image-only PDFs. Tesseract 5 (winget: UB-Mannheim.TesseractOCR).
OCR_PROVIDER=tesseract
OCR_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_TESSDATA_DIR=C:/Users/mayan/AppData/Local/tessdata
OCR_LANGUAGES=eng+hin
OCR_MAX_PAGES=10

# ---------------------------------------------------------------- Security
# development | production. Anything other than development/dev/local/test
# makes the API refuse to start until JWT_SECRET and SECRETS_KEY are strong
# (32+ characters, different from each other) and DEBUG is false.
ENVIRONMENT=development
DEBUG=true

# Signs login tokens. Blank = the development default (development only).
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Encrypts stored SMTP passwords. Its own value, not the JWT secret. Changing
# it later makes passwords already saved in Settings > Email unreadable.
SECRETS_KEY=

# Per-client limits. Sign-in and reset-password count FAILED attempts only;
# forgot-password counts every request. "<count>/<window>" with s, m or h
# (e.g. 10/1m, 30/15m). `_ACCOUNT` counts one client + one email together.
# Counted per API process. Behind a proxy, run uvicorn with --proxy-headers
# --forwarded-allow-ips=<proxy> or every user shares the proxy's counter.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=30/15m
RATE_LIMIT_LOGIN_ACCOUNT=10/15m
RATE_LIMIT_FORGOT_PASSWORD=30/15m
RATE_LIMIT_FORGOT_PASSWORD_ACCOUNT=5/15m
RATE_LIMIT_RESET_PASSWORD=30/15m
RATE_LIMIT_SUPPLIER_LOGIN=30/15m
RATE_LIMIT_SUPPLIER_LOGIN_ACCOUNT=10/15m
